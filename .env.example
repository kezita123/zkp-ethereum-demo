# Ethereum RPC URL (Ganache local, Sepolia testnet, or Mainnet)
RPC_URL=http://127.0.0.1:8545

# Private key for deploying contracts (NEVER commit real key)
PRIVATE_KEY=your_wallet_private_key_here

# Deployed contract address (filled after deployment)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Sepolia-specific (optional)
INFURA_KEY=your_infura_project_id_here
